# Copy to mobile/.env — values are baked into the app at build time.

# Backend URL. Leave unset to use production (https://agrosense-g0sb.onrender.com).
# For a phone on the same Wi-Fi as your laptop: http://<laptop-LAN-IP>:8000
EXPO_PUBLIC_API_URL=

# Google Sign-In (OAuth client IDs from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=870784188058-q70nltsf8ndqd8878q52hs1kds7l8ke2.apps.googleusercontent.com
# Setting this enables Google Sign-In on iOS; the URL scheme is derived from it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
